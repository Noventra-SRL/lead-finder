{
  "name": "noventra-lead-finder",
  "private": true,
  "version": "0.1.0",
  "description": "Piattaforma interna di Noventra per la ricerca e la qualificazione di potenziali clienti B2B.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.ts",
    "start:api": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:e2e": "playwright test",
    "test:live": "vitest run --config vitest.live.config.ts",
    "geo:update": "node scripts/istat-comuni.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:postgres",
    "db:status": "node --env-file-if-exists=.env server/db/cli.ts status",
    "db:migrate": "node --env-file-if-exists=.env server/db/cli.ts migrate",
    "user": "node --env-file-if-exists=.env server/auth/cli.ts",
    "db:check": "node --env-file-if-exists=.env scripts/integrity.ts",
    "db:backup": "node --env-file-if-exists=.env scripts/backup.ts backup",
    "db:restore": "node --env-file-if-exists=.env scripts/backup.ts restore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.0.0",
    "@electric-sql/pglite": "^0.5.10",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "nodemailer": "10.0.16",
    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  }
}
