      "css": ".ds-rail{display:grid;gap:2px;width:240px;padding:12px;background:#0132cc}.ds-link{display:flex;align-items:center;gap:12px;min-height:42px;padding:0 12px;border-radius:8px;color:rgb(255 255 255/.8);font-family:'Space Grotesk',system-ui,sans-serif;font-size:.9375rem;font-weight:500;text-decoration:none;transition:background 160ms,color 160ms}.ds-link>span:first-child{flex:1}.ds-link:hover{background:rgb(255 255 255/.1);color:#fff}.ds-link[aria-current=page]{background:#fff;color:#0132cc;font-weight:600}.ds-link:focus-visible{outline:none;box-shadow:0 0 0 2px #0132cc,0 0 0 4px #00ccff}.ds-count{min-width:22px;padding:0 6px;border-radius:999px;background:#00ccff;color:#0a1638;font-size:11px;font-weight:500;line-height:20px;text-align:center}"
