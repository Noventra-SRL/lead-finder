# Noventra Lead Finder — variabili d'ambiente.
# Copia questo file in .env e adatta i valori. .env non va mai versionato.
# Tutte le variabili sono validate all'avvio: un valore non valido ferma il server con un messaggio chiaro.

# NODE_ENV non va impostata in questo file: Vite la leggerebbe e compilerebbe l'interfaccia in modalità sviluppo.
# Senza NODE_ENV il server è in sviluppo; in produzione impostala nell'ambiente del servizio (NODE_ENV=production).

# --- Database ---------------------------------------------------------------
# PostgreSQL esterno (obbligatorio in produzione), es. postgres://utente:password@host:5432/leadfinder
# Se vuoto in sviluppo, si usa PostgreSQL incorporato (PGlite) nella cartella PGLITE_DATA_DIR.
DATABASE_URL=
# "require" per connessioni TLS verificate a un PostgreSQL gestito; "disable" o vuoto per nessun TLS.
DATABASE_SSL=
# Cartella dei dati di PGlite (solo sviluppo).
PGLITE_DATA_DIR=.data/pglite

# --- Server API -------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8810
# Origine pubblica dell'interfaccia (obbligatoria e https in produzione), es. https://leads.noventra.it
# Le richieste che modificano dati sono accettate solo da questa origine.
APP_ORIGIN=
# "1" solo se il server è dietro un proxy affidabile (l'IP del client arriva da X-Forwarded-For).
TRUST_PROXY=
# Livello dei log: debug | info | warn | error
LOG_LEVEL=info

# --- Scoperta di aziende (OpenStreetMap via Overpass API) ---------------------
# Endpoint Overpass. Vuoto = ricerca non disponibile (l'interfaccia lo dice chiaramente, nessun dato finto).
# Le istanze pubbliche sono condivise e spesso sature: per un uso regolare o commerciale usa un'istanza propria
# o un servizio dedicato. Opzioni pubbliche (verifica sempre le loro regole d'uso):
#   https://overpass.private.coffee/api/interpreter   (Private.coffee, senza limiti dichiarati; per progetti commerciali chiede una donazione;
#                                                      il 21/10/2026 serviva copie dei dati vecchie di mesi)
#   https://overpass-api.de/api/interpreter           (circa 10.000 richieste e 1 GB al giorno; spesso sovraccarico)
#   https://lz4.overpass-api.de/api/interpreter       (mirror ufficiale del precedente, stesse regole, dati aggiornati)
DISCOVERY_OVERPASS_URL=
# Recapito nello User-Agent delle richieste (email o URL), come chiesto dalle regole d'uso dei server pubblici.
DISCOVERY_CONTACT=
# Intervallo minimo tra due richieste al server (millisecondi). Le richieste sono sempre una alla volta.
DISCOVERY_MIN_INTERVAL_MS=10000
# Tempo massimo di una query sul server Overpass (secondi) e nuovi tentativi su 429/502/503/504.
DISCOVERY_QUERY_TIMEOUT_SECONDS=180
DISCOVERY_MAX_RETRIES=3
# Comuni per richiesta; numero massimo di richieste e di risultati per singola ricerca.
DISCOVERY_MUNICIPALITIES_PER_REQUEST=25
DISCOVERY_MAX_UNITS_PER_JOB=120
DISCOVERY_MAX_RESULTS_PER_JOB=5000
# Validità della cache dei risultati (ore): la stessa ricerca entro questo tempo non interroga di nuovo il server.
DISCOVERY_CACHE_TTL_HOURS=24
# I server pubblici possono usare copie dei dati OpenStreetMap vecchie di mesi: oltre questi giorni la ricerca
# lo segnala (avviso e stato "completata con avvisi"). La data dei dati è sempre registrata.
DISCOVERY_STALE_DATA_DAYS=7
# "off" per non eseguire le ricerche in questo processo (es. con più istanze dell'API, lasciandolo "on" in una sola).
DISCOVERY_WORKER=on

# --- Google Maps (Places API) ------------------------------------------------
# Facoltativo: seconda fonte per «Trova aziende». Serve un progetto Google Cloud con fatturazione attiva, l'API
# «Places API (New)» abilitata e una chiave API limitata a quella API e all'IP del server. La chiave resta sul server.
# Ogni richiesta è a pagamento (Text Search con sito e telefono): vedi docs/google-places.md per costi e condizioni d'uso.
GOOGLE_PLACES_API_KEY=
# Pagine da 20 risultati per ogni ricerca «<settore> a <comune>» (1–3; l'API non ne restituisce più di 3).
GOOGLE_PLACES_MAX_PAGES=3
# Richieste al giorno (limite di spesa): oltre, le ricerche si fermano e lo dichiarano. 0 = nessuna richiesta.
GOOGLE_PLACES_DAILY_LIMIT=1000
# Solo per i test automatici (NODE_ENV=test): server Google Places finto su 127.0.0.1. Lasciare vuoto.
GOOGLE_PLACES_TEST_BASE_URL=

# --- Audit dei siti web -----------------------------------------------------
# Pagine lette per sito (predefinito e massimo richiedibile per verifica).
AUDIT_DEFAULT_PAGES=3
AUDIT_MAX_PAGES=10
# Tempo massimo per richiesta e per la connessione (millisecondi).
AUDIT_REQUEST_TIMEOUT_MS=15000
AUDIT_CONNECT_TIMEOUT_MS=8000
# Dimensione massima di una risposta, anche dopo la decompressione (kB). Redirect massimi per richiesta.
AUDIT_MAX_RESPONSE_KB=3072
AUDIT_MAX_REDIRECTS=5
# Porte ammesse (solo indirizzi pubblici: la protezione SSRF non si disattiva).
AUDIT_ALLOWED_PORTS=80,443
# Intervallo minimo tra due richieste allo stesso sito (millisecondi, almeno 500) e aziende verificate in parallelo.
AUDIT_HOST_INTERVAL_MS=2000
AUDIT_CONCURRENCY=2
# Un sito verificato da meno di queste ore con la stessa configurazione non viene riletto (0 = sempre).
AUDIT_REAUDIT_HOURS=24
AUDIT_MAX_BUSINESSES_PER_JOB=200
# Recapito nello User-Agent dell'audit (email o URL); se vuoto si usa DISCOVERY_CONTACT.
AUDIT_CONTACT=
# Google PageSpeed Insights (facoltativo). Chiave da Google Cloud Console → API PageSpeed Insights.
# Resta sul server: mai nell'interfaccia o nelle risposte. Vuota = prestazioni non misurate (dichiarato negli audit).
PAGESPEED_API_KEY=
AUDIT_PAGESPEED=on
# mobile | desktop | mobile,desktop (ogni strategia consuma una richiesta della quota).
AUDIT_PAGESPEED_STRATEGIES=mobile
# "off" per non eseguire gli audit in questo processo (con più istanze dell'API lasciarlo "on" in una sola).
AUDIT_WORKER=on
# AUDIT_TEST_LOOPBACK_PORTS esiste solo per i test automatici (NODE_ENV=test): altrove ferma l'avvio. Non impostarla.

# --- Punteggio dei lead ------------------------------------------------------
# "off" per non eseguire i ricalcoli in background in questo processo (con più istanze lasciarlo "on" in una sola).
# Pesi, fasce e soglie non sono variabili d'ambiente: si modificano da Impostazioni (amministratori), con versioni.
SCORING_WORKER=on

# --- Lead Hunter -------------------------------------------------------------
# "off" per non coordinare le ricerche di lead in questo processo (con più istanze lasciarlo "on" in una sola).
# Usa il server Overpass e i limiti della scoperta (DISCOVERY_*) e dell'audit (AUDIT_*): nessuna API a pagamento.
HUNTER_WORKER=on

# --- Promemoria dei follow-up ----------------------------------------------------
# "off" per non aggiornare i promemoria in questo processo ogni 5 minuti (restano aggiornati all'apertura,
# al più una volta al minuto). Solo promemoria nell'applicazione: nessuna email, SMS o messaggio.
REMINDERS_WORKER=on

# --- Invio delle email commerciali (Google Workspace, casella staff@noventra.it) --------
# Senza SMTP_HOST le bozze restano disponibili ma l'invio è disattivato. Le credenziali restano sul server: mai
# nell'interfaccia, nelle risposte dell'API o nei registri. Valori di esempio, NON segreti reali.
#
# Google Workspace: STARTTLS sulla porta 587, accesso con l'indirizzo completo della casella e una password per le
# app (account Google > Sicurezza > Verifica in due passaggi > Password per le app; l'amministratore di Workspace
# deve consentirle). La password normale dell'account non funziona.
# Con Google Workspace: SMTP_HOST=smtp.gmail.com e SMTP_USER=staff@noventra.it (vuoti qui: senza la password il
# server non partirebbe, perché utente e password vanno impostati insieme).
SMTP_HOST=
SMTP_PORT=587
# false = STARTTLS (porta 587, obbligatorio: nessun invio in chiaro); true = TLS diretto (porta 465).
# Equivale a SMTP_SECURITY=starttls|tls (non indicarle entrambe con valori diversi).
SMTP_SECURE=false
SMTP_USER=
# Password per le app di Google (16 lettere; gli spazi mostrati da Google vengono tolti). Equivale a SMTP_PASSWORD.
SMTP_PASS=
# Mittente fisso e nome visualizzato (il client non può cambiarli). Equivalgono a EMAIL_FROM_ADDRESS/EMAIL_FROM_NAME.
EMAIL_SENDER=staff@noventra.it
EMAIL_SENDER_NAME=Noventra
# Facoltativo: indirizzo per le risposte.
EMAIL_REPLY_TO=
# "si" SOLO dopo aver verificato che il server SMTP può inviare da EMAIL_SENDER (con Google Workspace: la casella
# stessa, SPF e DKIM del dominio noventra.it): finché non è "si" l'invio resta bloccato con «Verifica necessaria».
EMAIL_SENDER_AUTHORIZED=no
EMAIL_TIMEOUT_SECONDS=30

# --- Sessioni ----------------------------------------------------------------
# Inattività massima prima della disconnessione (ore) e durata massima assoluta di una sessione (giorni).
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# --- AI: valutazione commerciale ed email personalizzate ---------------------------
# Chiave dell'API di Anthropic (console.anthropic.com → API Keys): SOLO sul server, mai nel frontend né nel
# controllo di versione. La stessa chiave attiva la valutazione AI e «Email personalizzata con AI».
# Vuota = AI disattivata: resta il punteggio a regole e il modello standard delle email. Ogni chiamata ha un costo.
# Dopo averla impostata riavvia il server: all'avvio la chiave viene verificata senza generare testo.
# ATTENZIONE: con AI_AUTO_ASSESS=on la chiave avvia anche la valutazione automatica di tutte le aziende.
AI_API_KEY=
# "none" disattiva l'AI anche con una chiave presente (vuoto = Anthropic se c'è la chiave).
AI_PROVIDER=
# Prezzi in USD per milione di token per la stima dei costi, solo per modelli non noti al programma.
AI_PRICE_INPUT_PER_MTOK=
AI_PRICE_OUTPUT_PER_MTOK=
# Modello (prezzi noti: claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, claude-fable-5-1) e impegno (low|medium|high).
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# Valutazioni contemporanee nei lotti, tempo massimo (s) e ripetizioni su errori temporanei.
AI_CONCURRENCY=2
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
# "off" per non eseguire i lotti in questo processo. AI_PROVIDER=none disattiva l'AI anche con una chiave presente.
AI_WORKER=on
# Valutazione automatica di OGNI azienda (nuove e già presenti): "off" per valutare solo a mano o a lotti.
# Senza AI_API_KEY si aggiorna solo lo stato (Da valutare, Da aggiornare…), senza chiamate né costi.
AI_AUTO_ASSESS=on
# Massimo di valutazioni automatiche nelle ultime 24 ore (controllo dei costi; 0 = nessuna).
AI_AUTO_DAILY_LIMIT=500
# AI_TEST_BASE_URL esiste solo per i test automatici (NODE_ENV=test): altrove ferma l'avvio. Non impostarla.
